    legT{end+1} = 'Ramo: carico < 40%'; %#ok<SAGROW>
end
if ~isempty(hLoadMid)
    legH{end+1} = hLoadMid; %#ok<SAGROW>
    legT{end+1} = 'Ramo: 40-<75%'; %#ok<SAGROW>
end
if ~isempty(hLoadHigh)
    legH{end+1} = hLoadHigh; %#ok<SAGROW>
    legT{end+1} = 'Ramo: 75-100%'; %#ok<SAGROW>
end
if ~isempty(hLoadOver)
    legH{end+1} = hLoadOver; %#ok<SAGROW>
    legT{end+1} = 'Ramo: >100%'; %#ok<SAGROW>
end
if ~isempty(hNoRate)
    legH{end+1} = hNoRate; %#ok<SAGROW>
    legT{end+1} = 'RATE_A non specificato'; %#ok<SAGROW>
end
legH{end+1} = hBus;
legT{end+1} = 'Bus senza generatore';
legH{end+1} = hGen;
legT{end+1} = 'Bus con generatore';
if ~isempty(hSlack)
    legH{end+1} = hSlack;
    legT{end+1} = 'Bus slack';
end
