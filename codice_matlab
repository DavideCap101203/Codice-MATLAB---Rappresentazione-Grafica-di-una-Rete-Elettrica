%% 10. DIAGNOSTICA NUMERICA: TENSIONI, GENERATORI E RAMI
fprintf('\n====================================================\n');
fprintf('DIAGNOSTICA LOAD FLOW AC - IEEE 39-BUS\n');
fprintf('====================================================\n');
fprintf('Load flow convergente: %d\n', success);
fprintf('Bus: %d | Generatori: %d | Rami: %d (in servizio: %d)\n', ...
    size(results.bus, 1), size(results.gen, 1), size(results.branch, 1), ...
    sum(branch_status));
fprintf('Tensione minima: %.4f p.u. al bus %g\n', min(V_mag), bus_num(V_mag == min(V_mag)));
fprintf('Tensione massima: %.4f p.u. al bus %g\n', max(V_mag), bus_num(V_mag == max(V_mag)));

% Violazioni di tensione rispetto ai limiti definiti per ciascun bus.
fprintf('\n--- Bus fuori limite di tensione ---\n');
if any(violV)
    disp(table(bus_num(violV), V_mag(violV), Vmin(violV), Vmax(violV), ...
        'VariableNames', {'Bus', 'Vm_pu', 'Vmin_pu', 'Vmax_pu'}));
else
    fprintf('Nessun bus fuori limite di tensione.\n');
end

% Verifica dei limiti P e Q dei generatori online.
gen_bus = results.gen(:, 1);
Pg = results.gen(:, 2);
Qg = results.gen(:, 3);
Qmax = results.gen(:, 4);
Qmin = results.gen(:, 5);
gen_status = results.gen(:, 8) > 0;
Pmax = results.gen(:, 9);
Pmin = results.gen(:, 10);

violP = gen_status & ((Pg < Pmin - tol) | (Pg > Pmax + tol));
violQ = gen_status & ((Qg < Qmin - tol) | (Qg > Qmax + tol));

fprintf('\n--- Generatori fuori limite di potenza attiva ---\n');
if any(violP)
    disp(table(gen_bus(violP), Pg(violP), Pmin(violP), Pmax(violP), ...
        'VariableNames', {'Bus', 'Pg_MW', 'Pmin_MW', 'Pmax_MW'}));
else
    fprintf('Nessun generatore online fuori limite P.\n');
end

fprintf('\n--- Generatori fuori limite di potenza reattiva ---\n');
if any(violQ)
    disp(table(gen_bus(violQ), Qg(violQ), Qmin(violQ), Qmax(violQ), ...
        'VariableNames', {'Bus', 'Qg_MVAr', 'Qmin_MVAr', 'Qmax_MVAr'}));
else
    fprintf('Nessun generatore online fuori limite Q.\n');
end

% Rami oltre RATE_A e statistiche del caricamento.
violBranch = valid_rate & (loading_pct > 100 + tol);
fprintf('\n--- Rami oltre il 100%% di RATE_A ---\n');
if any(violBranch)
    disp(table(from_bus(violBranch), to_bus(violBranch), ...
        loading_pct(violBranch), rate_A(violBranch), ...
        'VariableNames', {'FromBus', 'ToBus', 'Carico_pct', 'RATE_A_MVA'}));
else
    fprintf('Nessun ramo supera il 100%% dei limiti RATE_A specificati.\n');
end

if any(valid_rate)
    idxValid = find(valid_rate);
    [maxLoading, idxLocal] = max(loading_pct(valid_rate));
    idxMax = idxValid(idxLocal);
    fprintf('Massimo caricamento tra i rami con RATE_A specificato: %.2f%% sul ramo %g-%g.\n', ...
        maxLoading, from_bus(idxMax), to_bus(idxMax));
else
    fprintf('Non ci sono rami in servizio con RATE_A positivo.\n');
end

nNoRate = sum(branch_status & ~(rate_A > 0));
fprintf('Rami in servizio senza RATE_A positivo: %d (visualizzati grigi tratteggiati).\n', nNoRate);
