%% 1. CARICAMENTO DEL CASO E CALCOLO LOAD FLOW
mpc = case39();
mpopt = mpoption('verbose', 0, 'out.all', 0);
[results, success] = runpf(mpc, mpopt);

if ~success
    error('Il load flow AC non è convergente. Figura non generata.');
end

%% 2. ESTRAZIONE DEI RISULTATI
% Matrice bus dopo runpf:
%   col. 1 = numero bus, col. 2 = tipo bus, col. 8 = Vm,
%   col. 12 = VMAX, col. 13 = VMIN.
bus_num = results.bus(:, 1);
V_mag   = results.bus(:, 8);
Vmax    = results.bus(:, 12);
Vmin    = results.bus(:, 13);
bus_type = results.bus(:, 2);

% Matrice branch dopo runpf:
%   col. 1 = from, col. 2 = to, col. 6 = RATE_A,
%   col. 11 = status, col. 14:17 = PF, QF, PT, QT.
from_bus = results.branch(:, 1);
to_bus   = results.branch(:, 2);
rate_A   = results.branch(:, 6);
branch_status = results.branch(:, 11) ~= 0;

% Flussi apparenti alle due estremità (MVA).
PF = results.branch(:, 14);
QF = results.branch(:, 15);
PT = results.branch(:, 16);
QT = results.branch(:, 17);
SF = hypot(PF, QF);
ST = hypot(PT, QT);
Smax_MVA = max([SF, ST], [], 2);

% Calcolo del caricamento solo quando esiste un RATE_A positivo.
% RATE_A = 0 significa che il limite non è specificato nel modello:
% non viene sostituito con un valore arbitrario.
valid_rate = (rate_A > 0) & branch_status;
loading_pct = nan(size(rate_A));
loading_pct(valid_rate) = 100 .* Smax_MVA(valid_rate) ./ rate_A(valid_rate);

