% Riordina le coordinate secondo l'ordine effettivo in results.bus.
lat = coords(idxCoord, 2);
lon = coords(idxCoord, 3);

%% 4. CLASSIFICAZIONE DEI BUS E CONTROLLO DEI LIMITI DI TENSIONE
is_gen   = ismember(bus_num, results.gen(:, 1));
is_slack = (bus_type == 3);  % Tipo 3 = bus di riferimento (slack)

tol = 1e-6;
violV = (V_mag < Vmin - tol) | (V_mag > Vmax + tol);

% Etichette: bus di carico come "Bus N", generatori come "N" e slack esplicito.
etichette = cell(numel(bus_num), 1);
for k = 1:numel(bus_num)
    b = bus_num(k);
    if is_slack(k)
        etichette{k} = sprintf('%d (Slack)', b);
    elseif is_gen(k)
        etichette{k} = sprintf('%d', b);
    else
        etichette{k} = sprintf('Bus %d', b);
    end
end

%% 5. CREAZIONE DELLA FIGURA E DELLA MAPPA
fig = figure('Name', 'IEEE 39-Bus - Load Flow AC', ...
             'Position', [60, 40, 1450, 1000], ...
             'Color', 'w');
ax = geoaxes(fig);
geobasemap(ax, 'streets-light');
hold(ax, 'on');

% Colori dei rami classificati rispetto al RATE_A.
col_low   = [0.10, 0.40, 0.80];  % < 40%
col_mid   = [0.88, 0.70, 0.10];  % 40-<75%
col_high  = [0.95, 0.48, 0.08];  % 75-100%
col_over  = [0.80, 0.08, 0.08];  % > 100%
col_norate = [0.42, 0.42, 0.42]; % RATE_A non specificato

% Un solo handle per classe, per costruire la legenda senza duplicati.
hLoadLow = gobjects(0);
hLoadMid = gobjects(0);
hLoadHigh = gobjects(0);
hLoadOver = gobjects(0);
hNoRate = gobjects(0);

%% 6. DISEGNO DEI RAMI
for i = 1:size(results.branch, 1)
    if ~branch_status(i)
        % I rami fuori servizio non vengono disegnati come collegamenti attivi.
        continue;
    end

    f = from_bus(i);
    t = to_bus(i);
    idx_f = find(bus_num == f, 1);
    idx_t = find(bus_num == t, 1);

    if isempty(idx_f) || isempty(idx_t)
        warning('Coordinate mancanti per il ramo %g-%g; ramo ignorato nel plot.', f, t);
        continue;
    end

    lat_linea = [lat(idx_f), lat(idx_t)];
    lon_linea = [lon(idx_f), lon(idx_t)];

    if ~valid_rate(i)
        % Nessuna percentuale di caricamento se RATE_A è nullo/non definito.
        h = geoplot(ax, lat_linea, lon_linea, ...
            'Color', col_norate, 'LineStyle', '--', 'LineWidth', 1.5);
        if isempty(hNoRate), hNoRate = h; end
        continue;
    end

    carico_pct = loading_pct(i);

    if carico_pct < 40
        colore = col_low;
        spessore = 1.3;
        classe = 1;
    elseif carico_pct < 75
        colore = col_mid;
        spessore = 1.8;
        classe = 2;
    elseif carico_pct <= 100
        colore = col_high;
        spessore = 2.5;
        classe = 3;
    else
        colore = col_over;
        spessore = 3.5;
        classe = 4;
    end

    h = geoplot(ax, lat_linea, lon_linea, ...
        'Color', colore, 'LineStyle', '-', 'LineWidth', spessore);

    switch classe
        case 1
            if isempty(hLoadLow), hLoadLow = h; end
        case 2
            if isempty(hLoadMid), hLoadMid = h; end
        case 3
            if isempty(hLoadHigh), hLoadHigh = h; end
        case 4
            if isempty(hLoadOver), hLoadOver = h; end
    end
end

%% 7. DISEGNO DEI NODI: COLORE = TENSIONE NODALE
% il colore è assegnato soltanto alle tensioni calcolate sulle sbarre.
hBus = geoscatter(ax, lat(~is_gen), lon(~is_gen), 72, V_mag(~is_gen), ...
    'o', 'filled', 'MarkerEdgeColor', 'k', 'LineWidth', 0.9);

hGen = geoscatter(ax, lat(is_gen), lon(is_gen), 88, V_mag(is_gen), ...
    's', 'filled', 'MarkerEdgeColor', 'k', 'LineWidth', 1.1);

% Simbolo nero sovrapposto al bus slack; il quadrato sottostante conserva
% il colore associato alla tensione del nodo.
hSlack = gobjects(0);
if any(is_slack)
    hSlack = geoscatter(ax, lat(is_slack), lon(is_slack), 125, 'k', ...
        'p', 'filled', 'MarkerEdgeColor', 'w', 'LineWidth', 0.8);
end

% Cerchio esterno nero per evidenziare ogni bus fuori dai propri limiti VMIN/VMAX.
hViol = gobjects(0);
if any(violV)
    hViol = geoscatter(ax, lat(violV), lon(violV), 155, 'k', 'o', ...
        'MarkerFaceColor', 'none', 'LineWidth', 2.0);
end

